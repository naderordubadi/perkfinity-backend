generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "enterprise"]
}

// ─── Public Schema ────────────────────────────────────────────────────────────

model User {
  id          String         @id @default(uuid())
  email_enc   Bytes?
  phone_enc   Bytes?
  city        Bytes?
  postal_code Bytes?
  created_at  DateTime       @default(now())
  last_active DateTime?
  redemptions Redemption[]
  activations Activation[]
  events      Event[]
  // memberships MerchantMember[]

  @@schema("public")
}

model Merchant {
  id                String             @id @default(uuid())
  business_name     String
  legal_name        String?
  contact_name      String?
  phone             String?
  public_phone      String?
  public_email      String?
  website           String?
  review_url        String?
  order_url         String?
  logo_url          String?
  cover_photo_url   String?
  promo_description String?
  business_presence String?            @default("in_person")
  business_category String?
  welcome_offer_text String?
  is_multi_location Boolean            @default(false)
  status            String             @default("active")
  is_hidden         Boolean            @default(false)
  subscription_tier String             @default("free")
  member_limit      Int?
  billing_cycle     String?
  billing_status    String?
  application_status String?
  stripe_customer_id String?
  stripe_payment_method_id String?
  stripe_subscription_id String?
  billing_starts_at_member_count Int?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  campaigns         Campaign[]
  locations         MerchantLocation[]
  users             MerchantUser[]
  qr_codes          QrCode[]
  subscriptions     Subscription[]
  events            Event[]
  audit_logs        AuditLog[]
  // merchant_logos    MerchantLogo?
  // members           MerchantMember[]

  is_presetup         Boolean   @default(false)
  is_claimed          Boolean   @default(true)
  temp_password_plain String?
  presetup_claimed_at DateTime?

  is_app_sponsored      Boolean   @default(false)
  app_sponsored_until   DateTime?
  is_web_sponsored      Boolean   @default(false)
  web_sponsored_until   DateTime?
  is_fullpage_sponsored Boolean   @default(false)
  fullpage_sponsored_until DateTime?

  stripe_web_sponsor_subscription_id      String?
  stripe_app_sponsor_subscription_id      String?
  stripe_fullpage_sponsor_subscription_id String?
  stripe_bundle_sponsor_subscription_id   String?
  stripe_sponsor_subscription_id          String?

  @@schema("public")
}

model MerchantLocation {
  id            String     @id @default(uuid())
  merchant_id   String
  merchant      Merchant   @relation(fields: [merchant_id], references: [id])
  location_name String?
  address       String?
  city          String?
  state         String?
  postal_code   String?
  country       String     @default("US")
  timezone      String?
  is_active     Boolean    @default(true)
  created_at    DateTime   @default(now())
  qr_codes      QrCode[]
  campaigns     Campaign[]
  events        Event[]

  @@schema("public")
}

model MerchantUser {
  id            String       @id @default(uuid())
  merchant_id   String
  merchant      Merchant     @relation(fields: [merchant_id], references: [id])
  email         String       @unique
  password_hash String
  role          String       @default("owner")
  status        String       @default("active")
  created_at    DateTime     @default(now())
  redemptions   Redemption[]

  @@schema("public")
}

model Campaign {
  id                            String            @id @default(uuid())
  merchant_id                   String
  merchant                      Merchant          @relation(fields: [merchant_id], references: [id])
  location_id                   String?
  location                      MerchantLocation? @relation(fields: [location_id], references: [id])
  title                         String            @default("Instant Discount")
  discount_percentage           Int
  terms                         String?
  redemption_time_limit_minutes Int               @default(15)
  start_at                      DateTime?
  end_at                        DateTime?
  status                        String            @default("active")
  created_at                    DateTime          @default(now())
  updated_at                    DateTime          @updatedAt
  redemptions                   Redemption[]
  activations                   Activation[]
  events                        Event[]

  @@schema("public")
}

model QrCode {
  id          String            @id @default(uuid())
  merchant_id String
  merchant    Merchant          @relation(fields: [merchant_id], references: [id])
  location_id String?
  location    MerchantLocation? @relation(fields: [location_id], references: [id])
  public_code String            @unique
  status      String            @default("active")
  created_at  DateTime          @default(now())

  @@schema("public")
}

model Activation {
  id              String   @id @default(uuid())
  user_id         String
  user            User     @relation(fields: [user_id], references: [id])
  campaign_id     String
  campaign        Campaign @relation(fields: [campaign_id], references: [id])
  idempotency_key String?  @unique
  created_at      DateTime @default(now())

  @@schema("public")
}

model Redemption {
  id                           String        @id @default(uuid())
  user_id                      String
  user                         User          @relation(fields: [user_id], references: [id])
  campaign_id                  String
  campaign                     Campaign      @relation(fields: [campaign_id], references: [id])
  token                        String        @unique
  issued_at                    DateTime      @default(now())
  expires_at                   DateTime
  redeemed                     Boolean       @default(false)
  redeemed_at                  DateTime?
  redeemed_by_merchant_user_id String?
  redeemed_by                  MerchantUser? @relation(fields: [redeemed_by_merchant_user_id], references: [id])

  @@schema("public")
}

model Subscription {
  id                       String    @id @default(uuid())
  merchant_id              String
  merchant                 Merchant  @relation(fields: [merchant_id], references: [id])
  provider                 String?
  provider_customer_id     String?
  provider_subscription_id String?
  status                   String    @default("inactive")
  current_period_end       DateTime?
  created_at               DateTime  @default(now())

  @@schema("public")
}

model Event {
  id          String            @id @default(uuid())
  event_name  String
  user_id     String?
  user        User?             @relation(fields: [user_id], references: [id])
  merchant_id String?
  merchant    Merchant?         @relation(fields: [merchant_id], references: [id])
  campaign_id String?
  campaign    Campaign?         @relation(fields: [campaign_id], references: [id])
  location_id String?
  location    MerchantLocation? @relation(fields: [location_id], references: [id])
  metadata    Json              @default("{}")
  created_at  DateTime          @default(now())

  @@schema("public")
}

model AuditLog {
  id          String    @id @default(uuid())
  actor_type  String
  actor_id    String?
  merchant_id String?
  merchant    Merchant? @relation(fields: [merchant_id], references: [id])
  action      String
  target_type String?
  target_id   String?
  metadata    Json      @default("{}")
  created_at  DateTime  @default(now())

  @@schema("public")
}

model Contractor {
  id                        String    @id @default(uuid())
  full_name                 String
  legal_name                String?
  entity_type               String?
  email                     String    @unique
  phone                     String?
  address                   String?
  password_hash             String?
  referral_code             String    @unique
  status                    String    @default("pending")
  ica_status                String    @default("not_sent")
  ica_company_signatory     String?
  dropbox_sign_request_id   String?
  w9_status                 String    @default("not_sent")
  taxbandits_submission_id  String?
  payment_method            String    @default("stripe")
  stripe_account_id         String?
  stripe_onboarding_status  String    @default("not_started")
  notes                     String?
  invite_token              String?
  invite_expires_at         DateTime?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt

  @@schema("public")
}

model ContractorMerchantAttribution {
  id                     String    @id @default(uuid())
  contractor_id          String
  merchant_id            String    @unique
  source                 String    @default("referral_link")
  commission_start_date  DateTime?
  commission_end_date    DateTime?
  retention_bonuses_paid Int       @default(0)
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  @@schema("public")
}

// ─── Enterprise Schema ────────────────────────────────────────────────────────
// Tables live in the "enterprise" PostgreSQL schema, separate from "public".
// Inquiry data is captured from enterprise.html before a contract is signed.
// Post-contract operational tables (EnterpriseOrg, roles, hierarchy) will be
// added here once the first client signs.

model EnterpriseInquiry {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()::text"))
  company_legal_name       String
  brand_name               String?
  industry                 String
  website                  String
  hq_street                String?
  hq_city                  String?
  hq_state                 String?
  hq_zip                   String?
  hq_country               String                     @default("USA")
  num_locations            Int?
  geographic_reach         String?
  location_types           String?
  same_brand_name          Boolean                    @default(true)
  brand_note               String?
  operation_structure      String?
  operation_structure_note String?
  decision_authority       String?
  decision_authority_note  String?
  pos_system               String?
  has_loyalty              String                     @default("no")
  loyalty_name             String?
  loyalty_types            String?
  digital_deal             String?
  digital_deal_other       String?
  systems_integrated       String                     @default("no")
  integration_note         String?
  member_db_size           String?
  member_capture           String?
  wants_import             String                     @default("no")
  import_count             String?
  import_format            String?
  campaign_mgmt            String?
  data_visibility          String?
  notes                    String?
  contact_name             String
  contact_title            String?
  contact_email            String
  contact_phone            String?
  logo_url                 String?
  status                   String                     @default("new")
  admin_notes              String?
  submitted_at             DateTime                   @default(now())
  updated_at               DateTime                   @default(now()) @updatedAt
  history                  EnterpriseInquiryHistory[]

  @@schema("enterprise")
}

model EnterpriseInquiryHistory {
  id         String            @id @default(dbgenerated("gen_random_uuid()::text"))
  inquiry_id String
  inquiry    EnterpriseInquiry @relation(fields: [inquiry_id], references: [id])
  status     String
  note       String?
  changed_at DateTime          @default(now())

  @@schema("enterprise")
}
